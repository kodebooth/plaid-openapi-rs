{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.22.0",
    "generators": {
      "plaid-openapi-rs": {
        "generatorName": "rust",
        "inputSpec": "https://raw.githubusercontent.com/kodebooth/plaid-openapi/refs/tags/1.20.6/2020-09-14.yml",
        "additionalProperties": {
          "library": "reqwest-trait",
          "mockall": true,
          "packageName": "plaid-openapi-rs",
          "packageVersion": "1.20.6+0",
          "topLevelApiClient": true
        }
      }
    }
  }
}
